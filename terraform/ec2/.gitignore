# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform plan output
*.tfplan
*.out

# Sensitive variable files (optional, if you use them)
*.tfvars
*.tfvars.json

# Ignore override files as they are usually local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Ignore .tarraform.lock.hcl
.terraform.lock.hcl

# Ignore EC2 Key Pairs
*.pem
